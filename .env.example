# Copy to .env.local and fill in values for your environment.

# Base URL of the media/image server (used to resolve relative image paths in explore).
# Defaults to https://app.gaubook.org if not set.
NEXT_PUBLIC_API_BASE=https://app.gaubook.org

# Internal backend URL forwarded by the API proxy in development.
# Only needed when running the backend locally. Defaults to http://localhost:5001/v1.
BACKEND_URL=http://localhost:5001/v1
